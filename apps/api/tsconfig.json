{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "es6",
    "outDir": "dist",
    "baseUrl": ".",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "paths": {
      "@/*": ["./src/*"],
      "db": ["../../packages/db"],
      "config/*": ["../../packages/config/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
