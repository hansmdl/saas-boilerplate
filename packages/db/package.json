  },
  "dependencies": {
    "@nestjs/common": "~11.1.3",
    "@prisma/client": "6.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "config": "^4.0.0",
    "prisma": "~6.11.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.x"
  }
}
